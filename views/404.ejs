<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/nav') %>

    <main class="max-w-md mx-auto px-4 py-24 text-center">
        <div class="w-20 h-20 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-center justify-center mx-auto mb-5">
            <i data-lucide="search-x" class="w-9 h-9 text-slate-600"></i>
        </div>
        <h1 class="text-4xl font-bold gradient-text mb-2">404</h1>
        <p class="text-slate-400 mb-6"><%= typeof title !== 'undefined' ? title.replace(/^\d+ - /, '') : 'Halaman tidak ditemukan' %></p>
        <a href="/" class="btn-primary text-white px-6 py-3 rounded-xl inline-flex items-center gap-2 font-semibold text-sm">
            <i data-lucide="home" class="w-4 h-4"></i> Balik ke Home
        </a>
    </main>

    <%- include('partials/footer') %>
    <script>refreshIcons();</script>
</body>
</html>
