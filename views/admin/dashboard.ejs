<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/sidebar') %>

    <%- include('partials/toast') %>

    <main class="max-w-5xl mx-auto px-4 md:px-8 py-8">
        <div class="mb-8">
            <h1 class="text-2xl md:text-3xl font-bold gradient-text mb-1">Dashboard</h1>
            <p class="text-slate-400 text-sm">Selamat datang kembali! Kelola profil Nuxy MC kamu di sini.</p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-3 md:gap-4 mb-8">
            <div class="glass-card p-4 md:p-5">
                <i data-lucide="link" class="w-5 h-5 text-purple-400 mb-2"></i>
                <p class="text-2xl font-bold text-white"><%= stats.links %></p>
                <p class="text-slate-500 text-xs">Links</p>
            </div>
            <div class="glass-card p-4 md:p-5">
                <i data-lucide="boxes" class="w-5 h-5 text-purple-400 mb-2"></i>
                <p class="text-2xl font-bold text-white"><%= stats.mods %></p>
                <p class="text-slate-500 text-xs">Modpacks</p>
            </div>
            <div class="glass-card p-4 md:p-5">
                <i data-lucide="server" class="w-5 h-5 text-purple-400 mb-2"></i>
                <p class="text-2xl font-bold text-white"><%= stats.servers %></p>
                <p class="text-slate-500 text-xs">Servers</p>
            </div>
        </div>

        <!-- Menu Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a href="/admin/profile" class="glass-card rounded-2xl p-5 group hover:-translate-y-0.5 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="user-circle" class="w-5 h-5 text-purple-400"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-base font-semibold text-white mb-0.5">Edit Profile</h3>
                        <p class="text-slate-500 text-xs">Avatar, bio &amp; social links</p>
                    </div>
                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-600 self-center group-hover:text-purple-400 transition-colors"></i>
                </div>
            </a>

            <a href="/admin/mods" class="glass-card rounded-2xl p-5 group hover:-translate-y-0.5 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="boxes" class="w-5 h-5 text-purple-400"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-base font-semibold text-white mb-0.5">Modpacks</h3>
                        <p class="text-slate-500 text-xs">Tambah &amp; kelola modpack</p>
                    </div>
                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-600 self-center group-hover:text-purple-400 transition-colors"></i>
                </div>
            </a>

            <a href="/admin/servers" class="glass-card rounded-2xl p-5 group hover:-translate-y-0.5 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="server" class="w-5 h-5 text-purple-400"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-base font-semibold text-white mb-0.5">Servers</h3>
                        <p class="text-slate-500 text-xs">Konfigurasi server game</p>
                    </div>
                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-600 self-center group-hover:text-purple-400 transition-colors"></i>
                </div>
            </a>

            <a href="/admin/overlay" class="glass-card rounded-2xl p-5 group hover:-translate-y-0.5 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="tv" class="w-5 h-5 text-purple-400"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-base font-semibold text-white mb-0.5">Overlay Stream</h3>
                        <p class="text-slate-500 text-xs">Atur challenge untuk live streaming</p>
                    </div>
                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-600 self-center group-hover:text-purple-400 transition-colors"></i>
                </div>
            </a>

            <a href="/" target="_blank" class="glass-card rounded-2xl p-5 group hover:-translate-y-0.5 transition-all sm:col-span-2">
                <div class="flex items-center gap-4">
                    <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="external-link" class="w-5 h-5 text-purple-400"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-base font-semibold text-white mb-0.5">View Site</h3>
                        <p class="text-slate-500 text-xs">Lihat profil publik kamu</p>
                    </div>
                    <i data-lucide="chevron-right" class="w-4 h-4 text-slate-600 self-center group-hover:text-purple-400 transition-colors"></i>
                </div>
            </a>
        </div>
    </main>

    <%- include('partials/close') %>
    <script>refreshIcons();</script>
</body>
</html>
