<!-- ============ ADMIN SHELL: SIDEBAR (desktop) + TOPBAR (mobile) ============ -->
<div class="md:flex md:min-h-screen">
    <!-- Desktop Sidebar (Reference Palette) -->
    <aside class="hidden md:flex md:flex-col md:w-64 md:flex-shrink-0 border-r border-[#2C444C] bg-[#161928] min-h-screen sticky top-0 h-screen">
        <div class="px-5 py-5 border-b border-[#2C444C]">
            <a href="/admin" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#0474C4] flex items-center justify-center p-2 shadow-lg shadow-[#0474C4]/20">
                    <img src="/img/danuxy-logo.png" alt="Danuxy" class="w-full h-full object-contain brightness-200">
                </div>
                <div>
                    <p class="font-black text-white text-base leading-none">Nuxy MC</p>
                    <p class="text-[11px] text-[#A8C4EC] font-semibold font-mono mt-1">Admin Dashboard</p>
                </div>
            </a>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-1.5">
            <a href="/admin" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all <%= currentUrl === '/admin' ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 hover:text-white hover:bg-[#262B40]' %>">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
            </a>
            <a href="/admin/profile" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all <%= currentUrl.startsWith('/admin/profile') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 hover:text-white hover:bg-[#262B40]' %>">
                <i data-lucide="user-circle" class="w-4 h-4"></i> Profile
            </a>
            <a href="/admin/servers" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all <%= currentUrl.startsWith('/admin/servers') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 hover:text-white hover:bg-[#262B40]' %>">
                <i data-lucide="server" class="w-4 h-4"></i> Servers &amp; Sponsor
            </a>
            <a href="/admin/mods" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all <%= currentUrl.startsWith('/admin/mods') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 hover:text-white hover:bg-[#262B40]' %>">
                <i data-lucide="boxes" class="w-4 h-4"></i> Modpacks
            </a>
            <a href="/admin/overlay" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all <%= currentUrl.startsWith('/admin/overlay') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 hover:text-white hover:bg-[#262B40]' %>">
                <i data-lucide="tv" class="w-4 h-4"></i> Stream Overlay
            </a>

            <div class="pt-4 mt-4 border-t border-[#2C444C] space-y-1.5">
                <a href="/" target="_blank" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-[#262B40] transition-colors">
                    <i data-lucide="external-link" class="w-4 h-4 text-[#A8C4EC]"></i> View Website
                </a>
                <a href="/auth/logout" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-red-400 hover:bg-red-500/10 transition-colors">
                    <i data-lucide="log-out" class="w-4 h-4"></i> Logout
                </a>
            </div>
        </nav>

        <div class="px-5 py-4 border-t border-[#2C444C] text-xs text-slate-500 flex items-center justify-between">
            <span>Admin: <strong class="text-slate-300 font-mono"><%= user ? user.username : 'admin' %></strong></span>
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        </div>
    </aside>

    <!-- Mobile Topbar -->
    <div class="md:hidden sticky top-0 z-40 bg-[#161928]/95 backdrop-blur-md border-b border-[#2C444C]">
        <div class="flex items-center justify-between px-4 py-3">
            <a href="/admin" class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-[#0474C4] flex items-center justify-center p-1.5">
                    <img src="/img/danuxy-logo.png" alt="Danuxy" class="w-full h-full object-contain brightness-200">
                </div>
                <span class="font-extrabold text-white text-sm">NuxyMC Admin</span>
            </a>
            <div class="flex items-center gap-2">
                <a href="/" target="_blank" class="p-2 text-slate-400 hover:text-white">
                    <i data-lucide="external-link" class="w-4 h-4"></i>
                </a>
                <a href="/auth/logout" class="text-red-400 p-2 rounded-lg hover:bg-red-500/10">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                </a>
            </div>
        </div>
        <div class="flex gap-1.5 px-3 pb-3 overflow-x-auto">
            <a href="/admin" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap <%= currentUrl === '/admin' ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 bg-[#262B40]' %>">
                <i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i> Dashboard
            </a>
            <a href="/admin/profile" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap <%= currentUrl.startsWith('/admin/profile') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 bg-[#262B40]' %>">
                <i data-lucide="user-circle" class="w-3.5 h-3.5"></i> Profile
            </a>
            <a href="/admin/servers" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap <%= currentUrl.startsWith('/admin/servers') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 bg-[#262B40]' %>">
                <i data-lucide="server" class="w-3.5 h-3.5"></i> Servers
            </a>
            <a href="/admin/mods" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap <%= currentUrl.startsWith('/admin/mods') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 bg-[#262B40]' %>">
                <i data-lucide="boxes" class="w-3.5 h-3.5"></i> Mods
            </a>
            <a href="/admin/overlay" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap <%= currentUrl.startsWith('/admin/overlay') ? 'bg-[#06457F] text-[#A8C4EC] border border-[#5379AE]' : 'text-slate-400 bg-[#262B40]' %>">
                <i data-lucide="tv" class="w-3.5 h-3.5"></i> Overlay
            </a>
        </div>
    </div>

    <!-- Main content column -->
    <div class="flex-1 min-w-0 bg-[#161928]">
