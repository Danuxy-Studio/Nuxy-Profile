<!-- ============ ADMIN SHELL: SIDEBAR (desktop) + TOPBAR (mobile) ============ -->
<div class="md:flex md:min-h-screen">
    <!-- Desktop Sidebar -->
    <aside class="hidden md:flex md:flex-col md:w-60 md:flex-shrink-0 border-r border-slate-800/80 bg-slate-950/80 min-h-screen sticky top-0 h-screen">
        <div class="px-5 py-5 border-b border-slate-800/80">
            <a href="/admin" class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center shadow-lg shadow-purple-500/20">
                    <i data-lucide="shield" class="w-4 h-4 text-white"></i>
                </div>
                <div>
                    <p class="font-bold text-white text-sm leading-none">Nuxy MC</p>
                    <p class="text-[11px] text-slate-500 mt-0.5">Admin Panel</p>
                </div>
            </a>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-1">
            <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentUrl === '/admin' ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
            </a>
            <a href="/admin/profile" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentUrl.startsWith('/admin/profile') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
                <i data-lucide="user-circle" class="w-4 h-4"></i> Profile
            </a>
            <a href="/admin/mods" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentUrl.startsWith('/admin/mods') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
                <i data-lucide="boxes" class="w-4 h-4"></i> Modpacks
            </a>
            <a href="/admin/servers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentUrl.startsWith('/admin/servers') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
                <i data-lucide="server" class="w-4 h-4"></i> Servers
            </a>
            <a href="/admin/overlay" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentUrl.startsWith('/admin/overlay') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/60' %>">
                <i data-lucide="tv" class="w-4 h-4"></i> Overlay Stream
            </a>

            <div class="pt-3 mt-3 border-t border-slate-800/80 space-y-1">
                <a href="/" target="_blank" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors">
                    <i data-lucide="external-link" class="w-4 h-4"></i> View Site
                </a>
                <a href="/auth/logout" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-red-400 hover:bg-red-500/10 transition-colors">
                    <i data-lucide="log-out" class="w-4 h-4"></i> Logout
                </a>
            </div>
        </nav>

        <div class="px-5 py-4 border-t border-slate-800/80 text-[11px] text-slate-600">
            Logged in as <strong class="text-slate-400"><%= user ? user.username : 'admin' %></strong>
        </div>
    </aside>

    <!-- Mobile Topbar -->
    <div class="md:hidden sticky top-0 z-40 bg-slate-950/90 backdrop-blur-xl border-b border-slate-800/80">
        <div class="flex items-center justify-between px-4 py-3">
            <a href="/admin" class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center">
                    <i data-lucide="shield" class="w-4 h-4 text-white"></i>
                </div>
                <span class="font-bold text-white text-sm">Admin Panel</span>
            </a>
            <a href="/auth/logout" class="text-red-400 p-2 rounded-lg hover:bg-red-500/10">
                <i data-lucide="log-out" class="w-4 h-4"></i>
            </a>
        </div>
        <div class="flex gap-1 px-3 pb-3 overflow-x-auto">
            <a href="/admin" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap <%= currentUrl === '/admin' ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 bg-slate-800/50' %>">
                <i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i> Dashboard
            </a>
            <a href="/admin/profile" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap <%= currentUrl.startsWith('/admin/profile') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 bg-slate-800/50' %>">
                <i data-lucide="user-circle" class="w-3.5 h-3.5"></i> Profile
            </a>
            <a href="/admin/mods" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap <%= currentUrl.startsWith('/admin/mods') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 bg-slate-800/50' %>">
                <i data-lucide="boxes" class="w-3.5 h-3.5"></i> Mods
            </a>
            <a href="/admin/servers" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap <%= currentUrl.startsWith('/admin/servers') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 bg-slate-800/50' %>">
                <i data-lucide="server" class="w-3.5 h-3.5"></i> Servers
            </a>
            <a href="/admin/overlay" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap <%= currentUrl.startsWith('/admin/overlay') ? 'bg-purple-500/15 text-purple-400' : 'text-slate-400 bg-slate-800/50' %>">
                <i data-lucide="tv" class="w-3.5 h-3.5"></i> Overlay
            </a>
        </div>
    </div>

    <!-- Main content column -->
    <div class="flex-1 min-w-0">
