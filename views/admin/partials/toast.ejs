<% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
    <div class="fixed top-4 right-4 z-50 bg-[#0f141f] border border-emerald-500/50 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 animate-fade-up" id="flashToast">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
        <span class="text-sm font-semibold"><%= success_msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-2 text-slate-400 hover:text-white"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
<% } %>
<% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
    <div class="fixed top-4 right-4 z-50 bg-[#0f141f] border border-red-500/50 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 animate-fade-up" id="flashToast">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-400"></i>
        <span class="text-sm font-semibold"><%= error_msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-2 text-slate-400 hover:text-white"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
    </div>
<% } %>
<script>
    setTimeout(function() {
        var t = document.getElementById('flashToast');
        if (t) { 
            t.style.transition = 'opacity .3s ease'; 
            t.style.opacity = '0'; 
            setTimeout(function() { t.remove(); }, 300); 
        }
    }, 3500);
</script>
