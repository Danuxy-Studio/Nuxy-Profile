<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/sidebar') %>
    <%- include('partials/toast') %>

    <main class="max-w-3xl mx-auto px-4 md:px-8 py-8">
        <div class="flex items-center justify-between mb-6 gap-3">
            <div>
                <h1 class="text-2xl font-bold gradient-text mb-1">Overlay Stream</h1>
                <p class="text-slate-400 text-sm">Atur challenge donasi untuk overlay OBS</p>
            </div>
            <a href="/overlay" target="_blank" class="bg-slate-800/60 text-slate-300 px-3 py-2 rounded-lg text-xs hover:bg-slate-800 transition-colors flex items-center gap-1.5 flex-shrink-0">
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Preview
            </a>
        </div>

        <div class="glass-card p-4 mb-5 flex items-center gap-3 text-xs text-slate-400">
            <i data-lucide="info" class="w-4 h-4 text-purple-400 flex-shrink-0"></i>
            Tambahkan URL <code class="text-purple-400">/overlay</code> sebagai Browser Source di OBS. Ukuran dasar 400px, otomatis menyesuaikan.
        </div>

        <div id="challengeList" class="space-y-3 mb-5">
            <% challenges.forEach(function (c, idx) { %>
                <div class="challenge-row glass-card p-4 flex items-center gap-3" data-idx="<%= idx %>">
                    <input type="color" value="<%= c.color %>" class="c-color w-10 h-10 rounded-lg border-0 bg-transparent cursor-pointer flex-shrink-0">
                    <input type="text" value="<%= c.amount %>" placeholder="5K" class="c-amount w-20 bg-slate-900/60 border border-slate-700 rounded-lg px-2.5 py-2 text-white text-sm font-bold focus:border-purple-500 focus:outline-none">
                    <input type="text" value="<%= c.action %>" placeholder="Buang 1 Item" class="c-action flex-1 min-w-0 bg-slate-900/60 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:border-purple-500 focus:outline-none">
                    <button onclick="this.closest('.challenge-row').remove()" class="p-2 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-500/10 transition-colors flex-shrink-0"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                </div>
            <% }); %>
        </div>

        <button onclick="addRow()" class="w-full py-3 rounded-xl border-2 border-dashed border-slate-700 text-slate-400 hover:border-purple-500/50 hover:text-purple-400 transition-colors text-sm font-medium flex items-center justify-center gap-2 mb-5">
            <i data-lucide="plus" class="w-4 h-4"></i> Tambah Challenge
        </button>

        <button onclick="saveChallenges()" class="btn-primary text-white w-full py-3.5 rounded-xl font-semibold text-sm flex items-center justify-center gap-2">
            <i data-lucide="save" class="w-4 h-4"></i> Simpan Perubahan
        </button>
    </main>

    <%- include('partials/close') %>

    <script>
        refreshIcons();

        function addRow() {
            const list = document.getElementById('challengeList');
            const div = document.createElement('div');
            div.className = 'challenge-row glass-card p-4 flex items-center gap-3';
            div.innerHTML = `
                <input type="color" value="#A855F7" class="c-color w-10 h-10 rounded-lg border-0 bg-transparent cursor-pointer flex-shrink-0">
                <input type="text" placeholder="5K" class="c-amount w-20 bg-slate-900/60 border border-slate-700 rounded-lg px-2.5 py-2 text-white text-sm font-bold focus:border-purple-500 focus:outline-none">
                <input type="text" placeholder="Buang 1 Item" class="c-action flex-1 min-w-0 bg-slate-900/60 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:border-purple-500 focus:outline-none">
                <button onclick="this.closest('.challenge-row').remove()" class="p-2 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-500/10 transition-colors flex-shrink-0"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
            `;
            list.appendChild(div);
            refreshIcons();
        }

        async function saveChallenges() {
            const rows = document.querySelectorAll('.challenge-row');
            const challenges = Array.from(rows).map((row, idx) => ({
                id: idx + 1,
                amount: row.querySelector('.c-amount').value.trim(),
                action: row.querySelector('.c-action').value.trim(),
                color: row.querySelector('.c-color').value
            })).filter(c => c.amount && c.action);

            try {
                const res = await fetch('/api/overlay/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ challenges })
                });
                const data = await res.json();
                if (data.success) {
                    showToastAdmin('Overlay berhasil disimpan!', 'success');
                } else {
                    showToastAdmin(data.message || 'Gagal menyimpan', 'error');
                }
            } catch (err) {
                showToastAdmin('Terjadi kesalahan jaringan', 'error');
            }
        }

        function showToastAdmin(message, type) {
            const existing = document.getElementById('flashToast');
            if (existing) existing.remove();
            const bg = type === 'error' ? 'bg-red-500/90' : 'bg-purple-500/90';
            const icon = type === 'error' ? 'alert-circle' : 'check-circle';
            const toast = document.createElement('div');
            toast.id = 'flashToast';
            toast.className = `fixed top-4 right-4 z-50 ${bg} backdrop-blur text-white px-5 py-3 rounded-xl shadow-lg flex items-center gap-2`;
            toast.innerHTML = `<i data-lucide="${icon}" class="w-4 h-4"></i><span class="text-sm">${message}</span>`;
            document.body.appendChild(toast);
            refreshIcons();
            setTimeout(() => { toast.style.transition = 'opacity .3s'; toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
        }
    </script>
</body>
</html>
