<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-[#161928] text-slate-100 flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <div class="w-16 h-16 rounded-2xl bg-[#0474C4] flex items-center justify-center mx-auto mb-4 p-3.5 shadow-xl shadow-[#0474C4]/20">
                <img src="/img/danuxy-logo.png" alt="Danuxy" class="w-full h-full object-contain brightness-200">
            </div>
            <h1 class="text-2xl font-black text-white mb-1">Nuxy MC</h1>
            <p class="text-[#A8C4EC] font-mono text-xs font-semibold uppercase tracking-wider">Admin Panel &bull; Danuxy Studio</p>
        </div>

        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 rounded-xl mb-5 flex items-center gap-2">
                <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
                <span class="text-sm font-semibold"><%= error_msg %></span>
            </div>
        <% } %>
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 rounded-xl mb-5 flex items-center gap-2">
                <i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0"></i>
                <span class="text-sm font-semibold"><%= success_msg %></span>
            </div>
        <% } %>

        <div class="bento-card p-6 md:p-7 shadow-2xl">
            <form action="/auth/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-slate-300 text-xs font-semibold mb-1.5">Username</label>
                    <div class="relative">
                        <i data-lucide="user" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="text" name="username" required placeholder="admin" autocomplete="username"
                               class="w-full bg-[#1b2033] border border-[#2C444C] rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:border-[#0474C4] focus:outline-none transition-colors placeholder-slate-500">
                    </div>
                </div>
                <div>
                    <label class="block text-slate-300 text-xs font-semibold mb-1.5">Password</label>
                    <div class="relative">
                        <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="password" name="password" required placeholder="••••••••" autocomplete="current-password"
                               class="w-full bg-[#1b2033] border border-[#2C444C] rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:border-[#0474C4] focus:outline-none transition-colors placeholder-slate-500">
                    </div>
                </div>
                <button type="submit" class="w-full py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 mt-2 bg-[#0474C4] hover:bg-[#06457F] text-white transition-all shadow-lg shadow-[#0474C4]/20">
                    <i data-lucide="log-in" class="w-4 h-4"></i> Masuk Admin
                </button>
            </form>
        </div>

        <div class="text-center mt-6">
            <a href="/" class="inline-flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors text-xs font-semibold">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Kembali ke Website
            </a>
        </div>
        <p class="text-center text-slate-500 text-xs mt-8 font-mono">&copy; <%= new Date().getFullYear() %> NuxyMC by Danuxy Studio.</p>
    </div>
    <script>refreshIcons();</script>
</body>
</html>
