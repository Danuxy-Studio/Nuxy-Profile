<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm animate-fade-up">
        <div class="text-center mb-8">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-purple-500/20">
                <i data-lucide="shield" class="w-7 h-7 text-white"></i>
            </div>
            <h1 class="text-2xl font-bold gradient-text mb-1">Nuxy MC</h1>
            <p class="text-slate-500 text-sm">Admin Panel</p>
        </div>

        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 rounded-xl mb-5 flex items-center gap-2">
                <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
                <span class="text-sm"><%= error_msg %></span>
            </div>
        <% } %>
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="bg-purple-500/10 border border-purple-500/30 text-purple-400 px-4 py-3 rounded-xl mb-5 flex items-center gap-2">
                <i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0"></i>
                <span class="text-sm"><%= success_msg %></span>
            </div>
        <% } %>

        <div class="glass-card rounded-2xl p-6 md:p-7">
            <form action="/auth/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-slate-400 text-xs font-medium mb-1.5">Username</label>
                    <div class="relative">
                        <i data-lucide="user" class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="text" name="username" required placeholder="Masukkan username" autocomplete="username"
                               class="w-full bg-slate-900/60 border border-slate-700 rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors placeholder-slate-600">
                    </div>
                </div>
                <div>
                    <label class="block text-slate-400 text-xs font-medium mb-1.5">Password</label>
                    <div class="relative">
                        <i data-lucide="lock" class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="password" name="password" required placeholder="Masukkan password" autocomplete="current-password"
                               class="w-full bg-slate-900/60 border border-slate-700 rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors placeholder-slate-600">
                    </div>
                </div>
                <button type="submit" class="btn-primary text-white w-full py-3.5 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 mt-2">
                    <i data-lucide="log-in" class="w-4 h-4"></i> Sign In
                </button>
            </form>
        </div>

        <div class="text-center mt-6">
            <a href="/" class="inline-flex items-center gap-1.5 text-slate-500 hover:text-purple-400 transition-colors text-sm">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Back to Home
            </a>
        </div>
        <p class="text-center text-slate-700 text-xs mt-8">&copy; <%= new Date().getFullYear() %> Nuxy MC. All rights reserved.</p>
    </div>
    <script>refreshIcons();</script>
</body>
</html>
