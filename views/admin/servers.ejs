<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/sidebar') %>
    <%- include('partials/toast') %>

    <main class="max-w-4xl mx-auto px-4 md:px-8 py-8">
        <div class="flex items-center justify-between mb-6 gap-3">
            <div>
                <h1 class="text-2xl font-bold gradient-text mb-1">Manage Servers</h1>
                <p class="text-slate-400 text-sm"><%= servers.length %> server terdaftar</p>
            </div>
            <button onclick="openAddModal()" class="btn-primary text-white px-4 py-2.5 rounded-xl text-sm font-semibold flex items-center gap-2 flex-shrink-0">
                <i data-lucide="plus" class="w-4 h-4"></i> <span class="hidden sm:inline">Add Server</span>
            </button>
        </div>

        <% if (servers && servers.length > 0) { %>
            <div class="space-y-3">
                <% servers.forEach(function (server) { %>
                    <div class="glass-card p-4">
                        <div class="flex items-center gap-4 mb-2">
                            <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                                <i data-lucide="server" class="w-5 h-5 text-purple-400"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-white font-semibold text-sm truncate"><%= server.name %></p>
                                <div class="flex items-center gap-1.5 mt-1 flex-wrap">
                                    <% if (server.has_java) { %><span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400">Java</span><% } %>
                                    <% if (server.has_bedrock) { %><span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-400">Bedrock</span><% } %>
                                </div>
                            </div>
                            <div class="flex gap-1 flex-shrink-0">
                                <button onclick='openEditModal(<%- JSON.stringify(server) %>)' class="p-2 rounded-lg text-slate-400 hover:text-purple-400 hover:bg-purple-500/10 transition-colors"><i data-lucide="pencil" class="w-4 h-4"></i></button>
                                <button onclick="confirmDelete('<%= server.id %>', '<%= server.name.replace(/'/g, `\\'`) %>')" class="p-2 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-500/10 transition-colors"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                            </div>
                        </div>
                        <div class="text-xs text-slate-500 pl-[60px] space-y-0.5">
                            <% if (server.has_java) { %><p><span class="text-slate-600">Java:</span> <code class="text-purple-400"><%= server.java_ip %></code></p><% } %>
                            <% if (server.has_bedrock) { %><p><span class="text-slate-600">Bedrock:</span> <code class="text-purple-400"><%= server.bedrock_ip %>:<%= server.bedrock_port %></code></p><% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="glass-card p-10 text-center">
                <i data-lucide="server-off" class="w-12 h-12 text-slate-600 mx-auto mb-3"></i>
                <p class="text-slate-400">Belum ada server</p>
                <p class="text-slate-600 text-sm mt-1">Klik "Add Server" untuk menambahkan</p>
            </div>
        <% } %>
    </main>

    <!-- Add/Edit Modal -->
    <div id="serverModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeServerModal()"></div>
        <div class="glass-card rounded-2xl p-6 max-w-md w-full relative z-10 max-h-[90vh] overflow-y-auto">
            <h3 class="text-white font-bold text-lg mb-4 flex items-center gap-2" id="serverModalTitle">
                <i data-lucide="server" class="w-5 h-5 text-purple-400"></i> Add Server
            </h3>
            <form id="serverForm" method="POST" class="space-y-3">
                <div>
                    <label class="block text-slate-400 text-xs font-medium mb-1.5">Nama Server <span class="text-red-400">*</span></label>
                    <input type="text" name="name" id="srvName" required placeholder="Queen Craft" class="w-full bg-slate-900/60 border border-slate-700 rounded-xl px-3.5 py-2.5 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors">
                </div>

                <div class="bg-slate-900/40 rounded-xl p-3 space-y-2">
                    <label class="flex items-center gap-2 text-sm text-white cursor-pointer">
                        <input type="checkbox" name="has_java" id="srvHasJava" onchange="toggleField('java')" class="w-4 h-4 accent-purple-500"> Java Edition
                    </label>
                    <input type="text" name="java_ip" id="srvJavaIp" placeholder="play.example.com" class="w-full bg-slate-800/60 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors hidden" data-field="java">
                </div>

                <div class="bg-slate-900/40 rounded-xl p-3 space-y-2">
                    <label class="flex items-center gap-2 text-sm text-white cursor-pointer">
                        <input type="checkbox" name="has_bedrock" id="srvHasBedrock" onchange="toggleField('bedrock')" class="w-4 h-4 accent-purple-500"> Bedrock Edition
                    </label>
                    <div class="grid grid-cols-2 gap-2 hidden" id="bedrockFields" data-field="bedrock">
                        <input type="text" name="bedrock_ip" id="srvBedrockIp" placeholder="IP" class="w-full bg-slate-800/60 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors">
                        <input type="number" name="bedrock_port" id="srvBedrockPort" placeholder="19132" class="w-full bg-slate-800/60 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors">
                    </div>
                </div>

                <div>
                    <label class="block text-slate-400 text-xs font-medium mb-1.5">WhatsApp Community</label>
                    <input type="text" name="whatsapp" id="srvWhatsapp" placeholder="https://wa.me/..." class="w-full bg-slate-900/60 border border-slate-700 rounded-xl px-3.5 py-2.5 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors">
                </div>
                <div>
                    <label class="block text-slate-400 text-xs font-medium mb-1.5">Discord Community</label>
                    <input type="text" name="discord" id="srvDiscord" placeholder="https://discord.gg/..." class="w-full bg-slate-900/60 border border-slate-700 rounded-xl px-3.5 py-2.5 text-white text-sm focus:border-purple-500 focus:outline-none transition-colors">
                </div>

                <div class="flex gap-2 pt-2">
                    <button type="submit" class="btn-primary text-white flex-1 py-2.5 rounded-xl text-sm font-semibold flex items-center justify-center gap-2"><i data-lucide="save" class="w-4 h-4"></i>Save</button>
                    <button type="button" onclick="closeServerModal()" class="bg-slate-800 text-slate-300 px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-slate-700 transition-colors">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete confirm modal -->
    <div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
        <div class="glass-card rounded-2xl p-6 max-w-sm w-full relative z-10 text-center">
            <div class="w-14 h-14 rounded-full bg-red-500/10 flex items-center justify-center mx-auto mb-4"><i data-lucide="trash-2" class="w-6 h-6 text-red-400"></i></div>
            <h3 class="text-white font-bold text-lg mb-2">Hapus server?</h3>
            <p class="text-slate-400 text-sm mb-6">"<span id="deleteModName"></span>" akan dihapus permanen.</p>
            <div class="flex gap-2 justify-center">
                <button onclick="closeDeleteModal()" class="bg-slate-800 text-slate-300 px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-slate-700 transition-colors">Cancel</button>
                <a id="deleteConfirmLink" href="#" class="bg-red-500 text-white px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-red-600 transition-colors">Delete</a>
            </div>
        </div>
    </div>

    <%- include('partials/close') %>

    <script>
        refreshIcons();

        function toggleField(field) {
            const el = document.querySelector(`[data-field="${field}"]`);
            const checkbox = field === 'java' ? document.getElementById('srvHasJava') : document.getElementById('srvHasBedrock');
            if (el) el.classList.toggle('hidden', !checkbox.checked);
        }

        function openAddModal() {
            document.getElementById('serverModalTitle').innerHTML = '<i data-lucide="server" class="w-5 h-5 text-purple-400"></i> Add Server';
            document.getElementById('serverForm').action = '/admin/servers/add';
            document.getElementById('serverForm').reset();
            document.querySelectorAll('[data-field]').forEach(el => el.classList.add('hidden'));
            document.getElementById('serverModal').classList.remove('hidden');
            refreshIcons();
        }

        function openEditModal(server) {
            document.getElementById('serverModalTitle').innerHTML = '<i data-lucide="pencil" class="w-5 h-5 text-purple-400"></i> Edit Server';
            document.getElementById('serverForm').action = '/admin/servers/edit/' + server.id;
            document.getElementById('srvName').value = server.name || '';
            document.getElementById('srvHasJava').checked = !!server.has_java;
            document.getElementById('srvJavaIp').value = server.java_ip || '';
            document.getElementById('srvHasBedrock').checked = !!server.has_bedrock;
            document.getElementById('srvBedrockIp').value = server.bedrock_ip || '';
            document.getElementById('srvBedrockPort').value = server.bedrock_port || 19132;
            document.getElementById('srvWhatsapp').value = (server.community && server.community.whatsapp) || '';
            document.getElementById('srvDiscord').value = (server.community && server.community.discord) || '';
            toggleField('java');
            toggleField('bedrock');
            document.getElementById('serverModal').classList.remove('hidden');
            refreshIcons();
        }

        function closeServerModal() { document.getElementById('serverModal').classList.add('hidden'); }

        function confirmDelete(id, name) {
            document.getElementById('deleteModName').textContent = name;
            document.getElementById('deleteConfirmLink').href = '/admin/servers/delete/' + id;
            document.getElementById('deleteModal').classList.remove('hidden');
        }
        function closeDeleteModal() { document.getElementById('deleteModal').classList.add('hidden'); }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { closeServerModal(); closeDeleteModal(); }
        });
    </script>
</body>
</html>
