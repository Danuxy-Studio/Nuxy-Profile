<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen bg-[#161928] text-slate-100 pb-12">
    <%- include('partials/preloader') %>
    <%- include('partials/nav') %>

    <!-- Mobile-First Centered Container -->
    <main class="w-full px-4 py-5 md:py-8">
        <div class="max-w-xl mx-auto w-full space-y-4">

            <!-- Title & Breadcrumb -->
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2">
                        <i data-lucide="boxes" class="w-6 h-6 text-[#A8C4EC]"></i> Modpack Center
                    </h1>
                    <p class="text-slate-400 text-xs mt-0.5">
                        Download modpack Minecraft gratis &amp; aman.
                    </p>
                </div>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-mono pill-green flex items-center gap-1.5 flex-shrink-0">
                    <i data-lucide="shield-check" class="w-3 h-3"></i>
                    <span>Aman</span>
                </span>
            </div>

            <!-- Modpacks List -->
            <% if (mods && mods.length > 0) { %>
                <div class="space-y-3.5">
                    <% mods.forEach(function (mod) { %>
                        <div class="bento-card p-4 sm:p-5 flex flex-col justify-between group">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-2">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold pill-sky">
                                        MC <%= mod.mc_version %>
                                    </span>
                                    <span class="text-slate-400 text-[11px] font-mono"><%= mod.release_date %></span>
                                </div>
                                <h2 class="text-white font-extrabold text-base mb-1 group-hover:text-[#A8C4EC] transition-colors">
                                    <%= mod.name %>
                                </h2>
                                <p class="text-slate-300 text-xs leading-relaxed line-clamp-2">
                                    <%= mod.description %>
                                </p>
                            </div>
                            <div class="mt-3.5 pt-3 border-t border-[#2C444C] flex items-center justify-between">
                                <span class="text-[11px] text-slate-400">Official Release</span>
                                <a href="/download/<%= mod.id %>" 
                                   class="px-4 py-2 rounded-full btn-brand text-xs flex items-center gap-1.5">
                                    <i data-lucide="download" class="w-3.5 h-3.5"></i> Download
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="bento-card p-8 text-center">
                    <i data-lucide="package-open" class="w-10 h-10 text-slate-500 mx-auto mb-2"></i>
                    <p class="text-slate-300 font-bold text-sm">Belum ada modpack</p>
                    <p class="text-slate-400 text-xs mt-1">Cek kembali nanti ya!</p>
                </div>
            <% } %>

            <!-- Back to Home -->
            <div class="text-center pt-2">
                <a href="/" class="inline-flex items-center gap-1.5 text-slate-400 hover:text-white text-xs font-semibold">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Balik ke Home
                </a>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
    <script>refreshIcons();</script>
</body>
</html>
