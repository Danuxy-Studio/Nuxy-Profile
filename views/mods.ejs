<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/preloader') %>
    <%- include('partials/nav') %>

    <main class="max-w-4xl mx-auto px-4 py-8">
        <div class="mb-6 animate-fade-up">
            <h1 class="text-2xl md:text-3xl font-bold gradient-text flex items-center gap-2">
                <i data-lucide="boxes" class="w-7 h-7 text-purple-400"></i> Modpacks
            </h1>
            <p class="text-slate-400 text-sm mt-1">Klik download, tunggu 5 detik, selesai!</p>
        </div>

        <% if (mods && mods.length > 0) { %>
            <div class="grid gap-4 sm:grid-cols-2">
                <% mods.forEach(function (mod, idx) { %>
                    <div class="glass-card overflow-hidden flex flex-col stagger-item" style="animation-delay: <%= 0.06 * idx %>s">
                        <div class="p-5 flex-1">
                            <div class="flex items-start justify-between gap-3 mb-3">
                                <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="package" class="w-5 h-5 text-purple-400"></i>
                                </div>
                                <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-purple-500/15 text-purple-400 flex-shrink-0">
                                    MC <%= mod.mc_version %>
                                </span>
                            </div>
                            <h2 class="text-white font-bold text-lg mb-1"><%= mod.name %></h2>
                            <p class="text-slate-400 text-sm line-clamp-2"><%= mod.description %></p>
                            <p class="text-slate-600 text-xs mt-3 flex items-center gap-1.5">
                                <i data-lucide="calendar" class="w-3.5 h-3.5"></i> <%= mod.release_date %>
                            </p>
                        </div>
                        <a href="/download/<%= mod.id %>"
                           class="btn-primary text-white font-semibold text-sm py-3.5 flex items-center justify-center gap-2">
                            <i data-lucide="download" class="w-4 h-4"></i> Download Modpack
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="glass-card p-10 text-center">
                <i data-lucide="package-open" class="w-12 h-12 text-slate-600 mx-auto mb-3"></i>
                <p class="text-slate-400 font-medium">Belum ada modpack</p>
                <p class="text-slate-600 text-sm mt-1">Cek lagi nanti ya!</p>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>
    <script>refreshIcons();</script>
</body>
</html>
