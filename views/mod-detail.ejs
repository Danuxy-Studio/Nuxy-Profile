<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen bg-[#161928] text-slate-100 pb-12">
    <%- include('partials/preloader') %>
    <%- include('partials/nav') %>

    <!-- Mobile-First Centered Container -->
    <main class="w-full px-4 py-5 md:py-8">
        <div class="max-w-xl mx-auto w-full space-y-4">
            <a href="/mods" class="inline-flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors text-xs font-semibold">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Kembali ke Modpacks
            </a>

            <!-- Mod info Bento Card -->
            <div class="bento-card p-5 text-center">
                <div class="w-14 h-14 rounded-2xl bg-[#1b2033] border border-[#2C444C] flex items-center justify-center mx-auto mb-3 text-[#A8C4EC]">
                    <i data-lucide="package" class="w-7 h-7"></i>
                </div>
                <h1 class="text-xl font-black text-white"><%= mod.name %></h1>
                <div class="flex items-center justify-center gap-2 mt-1.5 text-xs text-slate-400">
                    <span class="pill-sky px-2.5 py-0.5 rounded-full font-bold text-[10px]">MC <%= mod.mc_version %></span>
                    <span>&bull;</span>
                    <span class="font-mono text-[11px]"><%= mod.release_date %></span>
                </div>
                <p class="text-slate-300 text-xs sm:text-sm mt-2.5 leading-relaxed"><%= mod.description %></p>
            </div>

            <!-- Countdown card -->
            <div class="bento-card p-6 text-center">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3">
                    Menyiapkan Link Download Resmi
                </p>

                <div class="relative w-20 h-20 mx-auto mb-3">
                    <svg class="w-20 h-20 -rotate-90" viewBox="0 0 96 96">
                        <circle cx="48" cy="48" r="42" fill="none" stroke="#2C444C" stroke-width="6"/>
                        <circle id="progressCircle" cx="48" cy="48" r="42" fill="none" stroke="#0474C4" stroke-width="6"
                                stroke-linecap="round" stroke-dasharray="263.9" stroke-dashoffset="0"
                                style="transition: stroke-dashoffset 0.3s linear;"/>
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span id="countdownNumber" class="text-2xl font-black text-white">5</span>
                    </div>
                </div>

                <p class="text-slate-300 text-xs mb-4" id="statusText">
                    Link akan aktif dalam <strong id="timeLeft" class="text-[#A8C4EC] font-bold">5</strong> detik
                </p>

                <a href="#" id="downloadBtn"
                   class="w-full py-3 rounded-full font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all bg-[#1b2033] border border-[#2C444C] text-slate-400 pointer-events-none">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                    <span>Mohon tunggu...</span>
                </a>

                <p class="text-slate-400 text-[10px] mt-3 flex items-center justify-center gap-1.5">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-400"></i> Unduhan resmi, aman &amp; bebas malware
                </p>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        (function () {
            let timeLeft = 5;
            const totalTime = 5;
            const circumference = 2 * Math.PI * 42;

            const countdownNumber = document.getElementById('countdownNumber');
            const timeLeftText = document.getElementById('timeLeft');
            const progressCircle = document.getElementById('progressCircle');
            const downloadBtn = document.getElementById('downloadBtn');
            const statusText = document.getElementById('statusText');

            const timer = setInterval(() => {
                timeLeft--;

                if (countdownNumber) countdownNumber.textContent = timeLeft;
                if (timeLeftText) timeLeftText.textContent = timeLeft;

                if (progressCircle) {
                    const offset = circumference * (1 - (timeLeft / totalTime));
                    progressCircle.style.strokeDashoffset = offset;
                }

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    if (statusText) statusText.innerHTML = '<span class="text-emerald-400 font-bold">Link download siap!</span>';
                    if (downloadBtn) {
                        downloadBtn.href = '/go/<%= mod.id %>';
                        downloadBtn.className = 'w-full py-3 rounded-full font-bold text-xs sm:text-sm flex items-center justify-center gap-2 bg-[#0474C4] hover:bg-[#06457F] text-white border border-[#5379AE] shadow-md';
                        downloadBtn.innerHTML = '<i data-lucide="download" class="w-4 h-4"></i><span>Download Sekarang</span>';
                        downloadBtn.style.pointerEvents = 'auto';
                        refreshIcons();
                    }
                }
            }, 1000);
        })();
    </script>
</body>
</html>
