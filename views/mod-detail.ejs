<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/preloader') %>
    <%- include('partials/nav') %>

    <main class="max-w-md mx-auto px-4 py-8">
        <a href="/mods" class="inline-flex items-center gap-1.5 text-slate-400 hover:text-purple-400 transition-colors text-sm mb-5 animate-fade-up">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Kembali ke Modpacks
        </a>

        <!-- Mod info -->
        <div class="glass-card p-6 text-center mb-5 animate-fade-up" style="animation-delay:.05s">
            <div class="w-16 h-16 rounded-2xl bg-purple-500/10 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="package" class="w-8 h-8 text-purple-400"></i>
            </div>
            <h1 class="text-xl font-bold text-white"><%= mod.name %></h1>
            <div class="flex items-center justify-center gap-2 mt-2 text-xs text-slate-500">
                <span class="bg-purple-500/15 text-purple-400 px-2.5 py-0.5 rounded-full font-semibold">MC <%= mod.mc_version %></span>
                <span>•</span>
                <span><%= mod.release_date %></span>
            </div>
            <p class="text-slate-400 text-sm mt-3"><%= mod.description %></p>
        </div>

        <!-- Transparent countdown card -->
        <div class="glass-card p-6 text-center animate-fade-up" style="animation-delay:.1s">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-4">
                Persiapan link download
            </p>

            <div class="relative w-24 h-24 mx-auto mb-4">
                <svg class="w-24 h-24 -rotate-90" viewBox="0 0 96 96">
                    <circle cx="48" cy="48" r="42" fill="none" stroke="rgba(168, 85, 247,0.15)" stroke-width="5"/>
                    <circle id="progressCircle" cx="48" cy="48" r="42" fill="none" stroke="#a855f7" stroke-width="5"
                            stroke-linecap="round" stroke-dasharray="263.9" stroke-dashoffset="0"
                            style="transition: stroke-dashoffset 0.3s linear;"/>
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span id="countdownNumber" class="text-3xl font-extrabold text-purple-400">5</span>
                </div>
            </div>

            <p class="text-slate-400 text-sm mb-5" id="statusText">
                Link akan aktif dalam <strong id="timeLeft" class="text-purple-400">5</strong> detik
            </p>

            <a href="#" id="downloadBtn"
               class="w-full py-3.5 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 transition-all bg-slate-800 text-slate-500 pointer-events-none">
                <i data-lucide="lock" class="w-4 h-4"></i>
                <span>Mohon tunggu...</span>
            </a>

            <p class="text-slate-600 text-xs mt-3 flex items-center justify-center gap-1.5">
                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-purple-500"></i> Aman &amp; gratis, tanpa popup mengganggu
            </p>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        (function () {
            refreshIcons();
            const TOTAL = 5;
            let timeLeft = TOTAL;
            const circle = document.getElementById('progressCircle');
            const circumference = 2 * Math.PI * 42;
            circle.style.strokeDasharray = circumference;

            function update() {
                const offset = circumference * (1 - (TOTAL - timeLeft) / TOTAL);
                circle.style.strokeDashoffset = offset;
                document.getElementById('countdownNumber').textContent = timeLeft;
                document.getElementById('timeLeft').textContent = timeLeft;
            }
            update();

            const timer = setInterval(() => {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    circle.style.stroke = '#a855f7';
                    circle.style.strokeDashoffset = 0;
                    document.getElementById('countdownNumber').textContent = '✓';
                    document.getElementById('statusText').innerHTML =
                        '<span class="text-purple-400 flex items-center justify-center gap-1.5"><svg width="14" height="14"></svg>Link download siap!</span>';

                    const btn = document.getElementById('downloadBtn');
                    btn.href = '/go/<%= mod.id %>';
                    btn.classList.remove('bg-slate-800', 'text-slate-500', 'pointer-events-none');
                    btn.classList.add('btn-primary', 'text-white');
                    btn.innerHTML = '<i data-lucide="download" class="w-4 h-4"></i><span>Download Sekarang</span>';
                    refreshIcons();
                    return;
                }
                update();
            }, 1000);
        })();
    </script>
</body>
</html>
