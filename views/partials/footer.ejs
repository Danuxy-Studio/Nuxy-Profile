<!-- Global Toast for Copy (Solid Slate) -->
<div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#0f141f] border border-[#1e2638] text-white px-4 py-2.5 rounded-full text-xs font-semibold hidden z-50 items-center gap-2 shadow-2xl">
    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400 flex-shrink-0"></i>
    <span id="toastMsg">Disalin!</span>
</div>

<script>
    function showToast(msg) {
        const toast = document.getElementById('toast');
        const msgEl = document.getElementById('toastMsg');
        if (!toast || !msgEl) return;
        msgEl.textContent = msg;
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        refreshIcons();
        clearTimeout(window.__toastTimer);
        window.__toastTimer = setTimeout(() => {
            toast.classList.add('hidden');
            toast.classList.remove('flex');
        }, 2200);
    }

    function copyText(text, btnElement) {
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            showToast('IP Berhasil Disalin! Siap dipaste di Minecraft 🚀');
            if (btnElement) {
                const icon = btnElement.querySelector('[data-lucide]');
                if (icon) {
                    icon.setAttribute('data-lucide', 'check');
                    refreshIcons();
                    setTimeout(() => {
                        icon.setAttribute('data-lucide', 'copy');
                        refreshIcons();
                    }, 2000);
                }
            }
        }).catch(() => {
            showToast('Salin: ' + text);
        });
    }

    refreshIcons();
</script>
