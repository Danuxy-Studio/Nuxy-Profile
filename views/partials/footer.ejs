<!-- Global toast -->
<div id="toast" class="fixed bottom-20 md:bottom-6 left-1/2 -translate-x-1/2 bg-slate-800/95 backdrop-blur border border-slate-700 text-white px-4 py-2.5 rounded-full text-sm hidden z-50 items-center gap-2 shadow-xl">
    <i data-lucide="check-circle" class="w-4 h-4 text-purple-400"></i>
    <span id="toastMsg">Disalin!</span>
</div>

<script>
    function showToast(msg, type) {
        const toast = document.getElementById('toast');
        const msgEl = document.getElementById('toastMsg');
        if (!toast || !msgEl) return;
        msgEl.textContent = msg;
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        refreshIcons();
        clearTimeout(window.__toastTimer);
        window.__toastTimer = setTimeout(() => {
            toast.classList.add('hidden');
            toast.classList.remove('flex');
        }, 2200);
    }

    function copyText(text) {
        navigator.clipboard.writeText(text).then(() => showToast('Disalin: ' + text))
            .catch(() => showToast('Gagal menyalin'));
    }

    refreshIcons();
</script>
