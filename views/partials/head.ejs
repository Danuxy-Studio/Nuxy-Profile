<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">

<!-- Primary Meta Tags -->
<title><%= typeof title !== 'undefined' && title !== 'Nuxy MC' ? title + ' - Nuxy MC' : 'Nuxy MC - Minecraft Streamer' %></title>
<meta name="title" content="Nuxy MC - Minecraft Streamer">
<meta name="description" content="Nuxy MC - Minecraft Streamer. Download modpack, join server, dan link komunitas.">
<meta name="keywords" content="nuxy mc, minecraft, modpack, server minecraft, minecraft streamer, download mod minecraft">
<meta name="author" content="Nuxy MC">
<meta name="robots" content="index, follow">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://<%= req ? req.get('host') : 'nuxymc.my.id' %>/">
<meta property="og:title" content="Nuxy MC - Minecraft Streamer">
<meta property="og:description" content="Download modpack Minecraft ku, join server, dan temukan link komunitasku!">
<meta property="og:image" content="https://<%= req ? req.get('host') : 'nuxymc.my.id' %>/img/avatar.png">
<meta property="og:site_name" content="Nuxy MC">
<meta property="og:locale" content="id_ID">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Nuxy MC - Minecraft Streamer">
<meta name="twitter:description" content="Download modpack Minecraft ku, join server, dan link komunitasku!">
<meta name="twitter:image" content="https://<%= req ? req.get('host') : 'nuxymc.my.id' %>/img/avatar.png">

<!-- Favicon -->
<link rel="icon" type="image/png" href="/img/avatar.png">
<link rel="shortcut icon" type="image/png" href="/img/avatar.png">
<link rel="apple-touch-icon" type="image/png" href="/img/avatar.png">

<!-- Anti white-flash background -->
<style>
    html, body { background-color: #020617; }
</style>

<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    accent: {
                        DEFAULT: '#a855f7',
                        light: '#c084fc',
                        dark: '#9333ea'
                    }
                },
                fontFamily: {
                    sans: ['Inter', 'ui-sans-serif', 'system-ui']
                }
            }
        }
    }
</script>

<style>
    * { -webkit-tap-highlight-color: transparent; }

    body {
        background-color: #020617; /* slate-950 */
        background-image: radial-gradient(circle at 20% 0%, rgba(168, 85, 247,0.08), transparent 40%),
                           radial-gradient(circle at 80% 100%, rgba(168, 85, 247,0.06), transparent 40%);
        color: #e2e8f0; /* slate-200 */
        font-family: 'Inter', sans-serif;
    }

    html { scroll-behavior: smooth; }

    /* Glassmorphism card */
    .glass-card {
        background: rgba(15, 23, 42, 0.6); /* slate-900/60 */
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(148, 163, 184, 0.1); /* slate-400/10 */
        border-radius: 1rem;
        transition: border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
    }
    .glass-card:hover {
        border-color: rgba(168, 85, 247, 0.35);
    }

    .btn-primary {
        background: linear-gradient(135deg, #a855f7, #9333ea);
        transition: all 0.2s ease;
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(168, 85, 247,0.3); }
    .btn-primary:active { transform: scale(0.98); }

    .gradient-text {
        background: linear-gradient(135deg, #d8b4fe, #c084fc, #a855f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #a855f7; border-radius: 4px; }

    [data-lucide] { display: inline-block; vertical-align: -3px; }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fadeInUp 0.45s cubic-bezier(0.4,0,0.2,1) forwards; }
    .stagger-item { opacity: 0; animation: fadeInUp 0.4s cubic-bezier(0.4,0,0.2,1) forwards; }

    .skeleton {
        background: linear-gradient(110deg, rgba(30,41,59,0.6) 8%, rgba(51,65,85,0.8) 18%, rgba(30,41,59,0.6) 33%);
        background-size: 200% 100%;
        animation: skeletonWave 1.5s linear infinite;
        border-radius: 1rem;
    }
    @keyframes skeletonWave { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    .content-wrapper { opacity: 0; transition: opacity 0.25s ease; }
    .content-wrapper.loaded { opacity: 1; }

    .safe-area-bottom { padding-bottom: env(safe-area-inset-bottom, 0px); }
</style>

<script>
    // Re-render Lucide icons after DOM changes
    function refreshIcons() { if (window.lucide) lucide.createIcons(); }
    document.addEventListener('DOMContentLoaded', refreshIcons);
</script>
