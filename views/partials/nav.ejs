<!-- ============ TOP NAVBAR (Clean Reference Palette) ============ -->
<header class="sticky top-0 z-50 bg-[#161928]/95 backdrop-blur-md border-b border-[#2C444C]" id="mainHeader">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-4">
        <!-- Brand Logo & Name -->
        <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
            <div class="w-8 h-8 rounded-xl bg-[#262B40] border border-[#2C444C] flex items-center justify-center p-1.5 transition-transform group-hover:scale-105">
                <img src="/img/danuxy-logo.png" alt="Danuxy Logo" class="w-full h-full object-contain">
            </div>
            <div class="flex flex-col">
                <span class="font-black text-white text-base tracking-tight leading-tight group-hover:text-[#A8C4EC] transition-colors">NuxyMC</span>
                <span class="text-[9px] text-[#A8C4EC] font-mono tracking-wider uppercase font-semibold">Danuxy Studio</span>
            </div>
        </a>

        <!-- Center Desktop Nav Links -->
        <nav class="hidden md:flex items-center gap-7 text-xs font-semibold text-slate-300">
            <a href="/" class="transition-colors hover:text-white <%= path === '/' ? 'text-[#A8C4EC] font-bold' : '' %>">Home</a>
            <a href="/servers" class="transition-colors hover:text-white <%= path === '/servers' ? 'text-[#A8C4EC] font-bold' : '' %>">Server Mabar</a>
            <a href="/mods" class="transition-colors hover:text-white <%= path === '/mods' ? 'text-[#A8C4EC] font-bold' : '' %>">Modpacks</a>
            <a href="https://sociabuzz.com/nuxy_mc/tribe" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[#A8C4EC] flex items-center gap-1 text-slate-300">
                <span>Donasi Stream</span>
                <i data-lucide="arrow-up-right" class="w-3 h-3 text-[#5379AE]"></i>
            </a>
            <a href="https://discord.gg/P5ZtPXKv7m" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[#A8C4EC] flex items-center gap-1 text-slate-300">
                <span>Komunitas</span>
                <i data-lucide="arrow-up-right" class="w-3 h-3 text-[#5379AE]"></i>
            </a>
        </nav>

        <!-- Right Side: Action Pills -->
        <div class="flex items-center gap-2.5 flex-shrink-0">
            <!-- Mobile Quick Server & Mods Pills -->
            <a href="/servers" class="md:hidden px-3 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white bg-[#262B40] border border-[#2C444C] transition-all <%= path === '/servers' ? '!border-[#5379AE] !text-[#A8C4EC]' : '' %>">
                Servers
            </a>
            <a href="/mods" class="md:hidden px-3 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white bg-[#262B40] border border-[#2C444C] transition-all <%= path === '/mods' ? '!border-[#5379AE] !text-[#A8C4EC]' : '' %>">
                Mods
            </a>

            <!-- Status Indicator Pill -->
            <div class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-mono bg-[#262B40] border border-[#2C444C] text-[#A8C4EC]">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-[11px] font-sans text-slate-300 font-medium">Online</span>
            </div>

            <!-- Masuk / Admin Pill Button -->
            <% if (user) { %>
                <a href="/admin" class="px-4 py-1.5 rounded-full text-xs font-bold text-[#A8C4EC] bg-[#262B40] border border-[#5379AE] hover:bg-[#06457F] transition-all flex items-center gap-1.5">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                    <span>Admin</span>
                </a>
            <% } else { %>
                <a href="/auth/login" class="px-4 py-1.5 rounded-full text-xs font-bold text-white bg-[#0474C4] hover:bg-[#06457F] border border-[#5379AE] shadow-sm transition-all flex items-center gap-1">
                    <span>Masuk</span>
                </a>
            <% } %>
        </div>
    </div>
</header>
