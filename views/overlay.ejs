<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Minecraft Challenge - Overlay</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: transparent !important;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            display: flex; align-items: center; justify-content: center;
            min-height: 100vh; width: 100%; overflow: visible;
        }
        .overlay-wrapper { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 100vh; }
        .overlay-base { width: 400px; transform-origin: center center; transition: transform 0.1s ease-out; }
        .overlay-box {
            background: rgba(22, 25, 40, 0.95);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            border: 1px solid #2C444C;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.6);
        }
        .overlay-header {
            background: linear-gradient(135deg, #161928, #262B40);
            padding: 16px 20px; text-align: center;
            border-bottom: 1px solid #2C444C;
        }
        .overlay-header h1 {
            font-size: 18px; font-weight: 800; color: white; letter-spacing: 1px;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .overlay-header h1 svg { color: #0474C4; width: 18px; height: 18px; }
        .overlay-header .sub { font-size: 10px; color: #A8C4EC; margin-top: 4px; letter-spacing: 0.5px; font-weight: 700; }
        .challenge-list { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
        .challenge-card {
            background: rgba(255,255,255,0.04);
            border-radius: 14px; padding: 12px 16px;
            display: flex; align-items: center; justify-content: space-between;
            border-left: 4px solid; animation: fadeInUp 0.3s ease forwards; opacity: 0;
        }
        .card-left { display: flex; align-items: center; gap: 12px; }
        .card-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
        .card-icon svg { width: 16px; height: 16px; }
        .card-amount { font-size: 18px; font-weight: 800; font-family: 'Inter', monospace; min-width: 55px; }
        .card-arrow { color: #64748b; font-size: 14px; margin: 0 10px; }
        .card-action { font-size: 14px; font-weight: 600; color: #e2e8f0; text-align: right; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .overlay-footer { background: rgba(0,0,0,0.4); padding: 10px 16px; text-align: center; border-top: 1px solid rgba(14, 165, 233, 0.2); }
        .overlay-footer p { font-size: 9px; color: #64748b; letter-spacing: 0.5px; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .challenge-card:nth-child(1) { animation-delay: .03s; } .challenge-card:nth-child(2) { animation-delay: .06s; }
        .challenge-card:nth-child(3) { animation-delay: .09s; } .challenge-card:nth-child(4) { animation-delay: .12s; }
        .challenge-card:nth-child(5) { animation-delay: .15s; } .challenge-card:nth-child(6) { animation-delay: .18s; }
        .challenge-card:nth-child(7) { animation-delay: .21s; }
    </style>
</head>
<body>
    <div class="overlay-wrapper">
        <div class="overlay-base" id="overlayBase">
            <div class="overlay-box">
                <div class="overlay-header">
                    <h1><i data-lucide="crown"></i> MINECRAFT CHALLENGE</h1>
                    <div class="sub">DONATION GOALS</div>
                </div>
                <div class="challenge-list">
                    <% challenges.forEach(function (challenge) { %>
                        <div class="challenge-card" style="border-left-color: <%= challenge.color %>;">
                            <div class="card-left">
                                <div class="card-icon" style="background: <%= challenge.color %>22;">
                                    <i data-lucide="trophy" style="color: <%= challenge.color %>;"></i>
                                </div>
                                <span class="card-amount" style="color: <%= challenge.color %>;"><%= challenge.amount %></span>
                            </div>
                            <span class="card-arrow">➜</span>
                            <span class="card-action"><%= challenge.action %></span>
                        </div>
                    <% }); %>
                </div>
                <div class="overlay-footer">
                    <p>⋆ ˖ ࣪ ✧ NYALA TERUS NIH YGY ✧ ࣪ ˖ ⋆</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();

        (function () {
            const baseEl = document.getElementById('overlayBase');
            if (!baseEl) return;
            const BASE_WIDTH = 400;
            function updateScale() {
                let scale = window.innerWidth / BASE_WIDTH;
                scale = Math.min(Math.max(scale, 0.5), 1);
                baseEl.style.transform = `scale(${scale})`;
            }
            window.addEventListener('load', updateScale);
            window.addEventListener('resize', updateScale);
            setTimeout(updateScale, 100);
            setTimeout(updateScale, 500);
        })();
    </script>
</body>
</html>
