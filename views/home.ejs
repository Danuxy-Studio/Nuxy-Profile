<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen bg-[#161928] text-slate-100 pb-12">
    <%- include('partials/preloader') %>
    <%- include('partials/nav') %>

    <!-- Mobile-First Centered Container (Optimized for Mobile, Clean on Desktop) -->
    <main class="w-full px-4 py-5 md:py-8">
        <div class="max-w-xl mx-auto w-full space-y-4">

            <!-- ============================================================== -->
            <!-- 1. PROFILE HEADER (Clean, Solid, Reference Palette)           -->
            <!-- ============================================================== -->
            <div class="bento-card p-4 sm:p-5 flex items-center gap-3.5 sm:gap-4">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden bg-[#1b2033] border border-[#2C444C] flex-shrink-0 relative">
                    <img src="/img/avatar.png" alt="Nuxy MC" class="w-full h-full object-cover">
                    <span class="absolute bottom-1 right-1 w-2.5 h-2.5 rounded-full bg-emerald-400 border-2 border-[#262B40]"></span>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <h1 class="text-lg sm:text-xl font-black text-white tracking-tight"><%= profile.name || 'Nuxy MC' %></h1>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold pill-sky">Danuxy Studio</span>
                    </div>
                    <p class="text-slate-300 text-xs mt-1 leading-snug line-clamp-2">
                        <%= profile.bio || 'Seorang pria yang suka bermain Minecraft, Roblox, Mobile Legends, dan game lainnya. Support aku terus ya biar semangat ngontennya 🥰' %>
                    </p>
                    <div class="flex items-center gap-2 mt-2 text-[10px] text-slate-400">
                        <span class="flex items-center gap-1 text-[#A8C4EC] font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Online
                        </span>
                        <span class="text-[#5379AE]">&bull;</span>
                        <span class="text-slate-300">Minecraft Streamer</span>
                    </div>
                </div>
            </div>

            <!-- ============================================================== -->
            <!-- 2. FOKUS 1: SPOTLIGHT SPONSOR OF THE WEEK                      -->
            <!-- ============================================================== -->
            <% if (sponsorServer) { %>
            <div class="bento-card p-5 sm:p-6 relative overflow-hidden border-[#5379AE]/60">
                <!-- Top Row: Badge & Live Player Counter -->
                <div class="flex items-center justify-between gap-2 mb-3.5 flex-wrap">
                    <span class="px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-extrabold tracking-wider uppercase pill-amber flex items-center gap-1.5">
                        <i data-lucide="star" class="w-3.5 h-3.5 fill-[#A8C4EC] text-[#A8C4EC]"></i>
                        <%= sponsorServer.sponsor_badge || 'SPONSOR MINGGU INI' %>
                    </span>

                    <!-- Live Player Detection Badge (Pure HTML data attributes) -->
                    <span id="sponsorPlayerBadge" 
                          data-ip="<%= sponsorServer.java_ip || sponsorServer.bedrock_ip || '' %>"
                          data-type="<%= (sponsorServer && !sponsorServer.has_java && sponsorServer.has_bedrock) ? 'bedrock' : 'java' %>"
                          data-port="<%= sponsorServer.bedrock_port || '' %>"
                          class="px-2.5 py-1 rounded-full text-[11px] font-mono bg-[#1b2033] border border-[#2C444C] text-[#A8C4EC] flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="sponsorPlayerCount">Deteksi server...</span>
                    </span>
                </div>

                <!-- Server Name & Description -->
                <div class="mb-4">
                    <div class="flex items-baseline gap-2">
                        <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight"><%= sponsorServer.name %></h2>
                        <span class="text-[11px] text-[#A8C4EC] font-semibold">Mabar Minggu Ini</span>
                    </div>
                    <p class="text-slate-300 text-xs sm:text-sm mt-1 leading-relaxed">
                        <%= sponsorServer.sponsor_description || 'Server mabar pilihan minggu ini. Yuk langsung login bareng Nuxy!' %>
                    </p>
                </div>

                <!-- IP & Port Format (Tampilan Asli Dipertahankan Agar Mudah Disalin) -->
                <div class="space-y-2.5 mb-4">
                    <% if (sponsorServer.has_java && sponsorServer.java_ip) { %>
                        <div class="bg-[#1b2033] border border-[#2C444C] rounded-2xl p-3">
                            <div class="flex items-center justify-between text-xs text-slate-300 font-semibold mb-1.5">
                                <span class="flex items-center gap-1.5 text-[#A8C4EC]">
                                    <i data-lucide="coffee" class="w-3.5 h-3.5"></i> Java Edition IP
                                </span>
                                <span class="text-[10px] text-[#5379AE]">Klik untuk salin</span>
                            </div>
                            <button onclick="copyText('<%= sponsorServer.java_ip %>', this)" 
                                    class="w-full bg-[#262B40] hover:bg-[#1b2033] border border-[#2C444C] hover:border-[#5379AE] rounded-xl px-3.5 py-2.5 flex items-center justify-between gap-2 transition-all text-left group">
                                <code class="text-[#A8C4EC] font-mono text-xs sm:text-sm font-bold truncate"><%= sponsorServer.java_ip %></code>
                                <i data-lucide="copy" class="w-4 h-4 text-[#5379AE] group-hover:text-[#A8C4EC] flex-shrink-0 transition-colors"></i>
                            </button>
                        </div>
                    <% } %>

                    <% if (sponsorServer.has_bedrock && sponsorServer.bedrock_ip) { %>
                        <div class="bg-[#1b2033] border border-[#2C444C] rounded-2xl p-3">
                            <div class="flex items-center justify-between text-xs text-slate-300 font-semibold mb-1.5">
                                <span class="flex items-center gap-1.5 text-[#A8C4EC]">
                                    <i data-lucide="smartphone" class="w-3.5 h-3.5"></i> Bedrock / MCPE Edition
                                </span>
                                <span class="text-[10px] text-[#5379AE]">Klik untuk salin</span>
                            </div>
                            <div class="grid grid-cols-12 gap-2">
                                <div class="col-span-8">
                                    <button onclick="copyText('<%= sponsorServer.bedrock_ip %>', this)" 
                                            class="w-full bg-[#262B40] hover:bg-[#1b2033] border border-[#2C444C] hover:border-[#5379AE] rounded-xl px-3 py-2 flex items-center justify-between gap-1 transition-all text-left group">
                                        <div class="min-w-0">
                                            <span class="block text-[9px] text-[#5379AE] uppercase font-mono">IP</span>
                                            <code class="text-[#A8C4EC] font-mono text-xs font-bold truncate block"><%= sponsorServer.bedrock_ip %></code>
                                        </div>
                                        <i data-lucide="copy" class="w-3.5 h-3.5 text-[#5379AE] group-hover:text-[#A8C4EC] flex-shrink-0"></i>
                                    </button>
                                </div>
                                <div class="col-span-4">
                                    <button onclick="copyText('<%= sponsorServer.bedrock_port || 19132 %>', this)" 
                                            class="w-full bg-[#262B40] hover:bg-[#1b2033] border border-[#2C444C] hover:border-[#5379AE] rounded-xl px-2.5 py-2 flex items-center justify-between gap-1 transition-all text-left group">
                                        <div class="min-w-0">
                                            <span class="block text-[9px] text-[#5379AE] uppercase font-mono">Port</span>
                                            <code class="text-[#A8C4EC] font-mono text-xs font-bold truncate block"><%= sponsorServer.bedrock_port || 19132 %></code>
                                        </div>
                                        <i data-lucide="copy" class="w-3.5 h-3.5 text-[#5379AE] group-hover:text-[#A8C4EC] flex-shrink-0"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- CTA Mabar (Pill Button) -->
                <div class="flex items-center gap-2 pt-2 border-t border-[#2C444C]">
                    <button onclick="copyText('<%= sponsorServer.java_ip || sponsorServer.bedrock_ip %>', this)" 
                            class="flex-1 py-3 px-4 rounded-full btn-brand text-xs sm:text-sm flex items-center justify-center gap-2">
                        <i data-lucide="gamepad-2" class="w-4 h-4"></i>
                        <span>Salin IP &amp; Mabar Sekarang</span>
                    </button>
                    <% if (sponsorServer.community && sponsorServer.community.discord) { %>
                        <a href="<%= sponsorServer.community.discord %>" target="_blank" rel="noopener noreferrer" 
                           class="py-3 px-3.5 rounded-full bg-[#262B40] hover:bg-[#1b2033] border border-[#2C444C] text-[#A8C4EC] text-xs font-bold flex items-center justify-center transition-all">
                            <i data-lucide="message-square" class="w-4 h-4 text-[#A8C4EC]"></i>
                        </a>
                    <% } %>
                </div>
            </div>
            <% } %>

            <!-- ============================================================== -->
            <!-- 3. FOKUS 2: DONATION & SUPPORT CARD (Alami, Ramah, Khas Gamer)  -->
            <!-- ============================================================== -->
            <div class="bento-card p-5 sm:p-6 border-[#2C444C]">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-extrabold tracking-wider uppercase pill-sky flex items-center gap-1.5">
                        <i data-lucide="heart" class="w-3.5 h-3.5 fill-[#A8C4EC] text-[#A8C4EC]"></i>
                        SUPPORT STREAM
                    </span>
                    <span class="text-[10px] text-[#A8C4EC] font-mono">QRIS &amp; E-Wallet</span>
                </div>

                <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight mt-1">
                    Dukung Live Stream NuxyMC ☕
                </h2>
                <p class="text-slate-300 text-xs sm:text-sm mt-1.5 leading-relaxed">
                    Buat jajan kopi, beli cemilan pas live, &amp; upgrade kebutuhan konten. Makasih banyak buat kalian yang udah support!
                </p>

                <!-- Stream Alert Info -->
                <div class="mt-3.5 p-3 rounded-2xl bg-[#1b2033] border border-[#2C444C] flex items-center gap-2.5 text-xs text-slate-300">
                    <i data-lucide="sparkles" class="w-4 h-4 text-[#A8C4EC] flex-shrink-0"></i>
                    <span>Notif donasi &amp; pesan kamu bakal <strong class="text-white">langsung muncul di layar</strong> pas live stream!</span>
                </div>

                <!-- CTA Donasi Pill Button (Clean, Selaras dengan Palette) -->
                <div class="mt-4">
                    <a href="https://sociabuzz.com/nuxy_mc/tribe" target="_blank" rel="noopener noreferrer" 
                       class="w-full py-3.5 px-4 rounded-full bg-[#0474C4] hover:bg-[#06457F] text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all border border-[#5379AE] shadow-md">
                        <i data-lucide="gift" class="w-4 h-4"></i>
                        <span>Kirim Donasi via SociaBuzz</span>
                        <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                    </a>
                    <div class="flex items-center justify-center gap-2 mt-2.5 text-[10px] text-[#A8C4EC]/70 font-mono">
                        <span>QRIS</span> &bull; <span>GoPay</span> &bull; <span>OVO</span> &bull; <span>DANA</span> &bull; <span>ShopeePay</span>
                    </div>
                </div>
            </div>

            <!-- ============================================================== -->
            <!-- 4. LINK KOMUNITAS & SOCIALS                                    -->
            <!-- ============================================================== -->
            <div class="space-y-2.5">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider px-1">Tautan Resmi &amp; Komunitas</p>

                <% if (profile.socials && profile.socials.length > 0) { %>
                    <% profile.socials.forEach(function (item) { 
                        let pillClass = 'pill-sky';
                        let pillText = 'Social';
                        if (item.type === 'donate') { pillClass = 'pill-rose'; pillText = 'Support'; }
                        else if (item.type === 'community') { pillClass = 'pill-green'; pillText = 'Komunitas'; }
                    %>
                        <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" 
                           class="bento-card p-3.5 sm:p-4 flex items-center justify-between gap-3 hover:border-[#5379AE] transition-all group">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-xl bg-[#1b2033] border border-[#2C444C] flex items-center justify-center flex-shrink-0 text-[#A8C4EC] group-hover:text-white transition-colors">
                                    <% if (item.type === 'donate' || item.icon === 'heart') { %>
                                        <i data-lucide="heart" class="w-5 h-5 text-[#A8C4EC]"></i>
                                    <% } else if ((item.icon && item.icon === 'whatsapp') || item.url.includes('whatsapp') || item.url.includes('wa.me')) { %>
                                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413Z"/>
                                        </svg>
                                    <% } else if ((item.icon && item.icon === 'youtube') || item.url.includes('youtube') || item.url.includes('youtu.be')) { %>
                                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                        </svg>
                                    <% } else if ((item.icon && item.icon === 'discord') || item.url.includes('discord')) { %>
                                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                                        </svg>
                                    <% } else if ((item.icon && (item.icon === 'tiktok' || item.icon === 'music-2')) || item.url.includes('tiktok')) { %>
                                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                                        </svg>
                                    <% } else if ((item.icon && item.icon === 'instagram') || item.url.includes('instagram')) { %>
                                        <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                                        </svg>
                                    <% } else { %>
                                        <i data-lucide="<%= item.icon || 'globe' %>" class="w-5 h-5 text-[#A8C4EC]"></i>
                                    <% } %>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2">
                                        <p class="font-bold text-white text-sm truncate"><%= item.name %></p>
                                        <span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= pillClass %>"><%= pillText %></span>
                                    </div>
                                    <p class="text-[#5379AE] text-xs font-mono truncate mt-0.5"><%= item.url.replace(/^https?:\/\//, '') %></p>
                                </div>
                            </div>
                            <div class="bento-arrow-btn">
                                <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                            </div>
                        </a>
                    <% }); %>
                <% } %>
            </div>

            <!-- ============================================================== -->
            <!-- 5. QUICK MENU: SERVERS & MODPACKS (2 Columns)                 -->
            <!-- ============================================================== -->
            <div class="grid grid-cols-2 gap-3 pt-1">
                <a href="/servers" class="bento-card p-4 hover:border-[#5379AE] transition-all flex flex-col justify-between group">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-9 h-9 rounded-xl bg-[#1b2033] border border-[#2C444C] flex items-center justify-center text-[#A8C4EC]">
                            <i data-lucide="server" class="w-5 h-5"></i>
                        </div>
                        <div class="bento-arrow-btn">
                            <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div>
                        <p class="text-white text-sm font-bold group-hover:text-[#A8C4EC] transition-colors">Daftar Server</p>
                        <p class="text-slate-400 text-[11px] mt-0.5">Info IP Java &amp; Bedrock</p>
                    </div>
                </a>

                <a href="/mods" class="bento-card p-4 hover:border-[#5379AE] transition-all flex flex-col justify-between group">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-9 h-9 rounded-xl bg-[#1b2033] border border-[#2C444C] flex items-center justify-center text-[#A8C4EC]">
                            <i data-lucide="boxes" class="w-5 h-5"></i>
                        </div>
                        <div class="bento-arrow-btn">
                            <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div>
                        <p class="text-white text-sm font-bold group-hover:text-[#A8C4EC] transition-colors">Modpack Center</p>
                        <p class="text-slate-400 text-[11px] mt-0.5">Download gratis &amp; aman</p>
                    </div>
                </a>
            </div>

            <!-- ============================================================== -->
            <!-- 6. OPEN ENDORSEMENT & SPONSOR CARD                             -->
            <!-- ============================================================== -->
            <div class="bento-card p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-[#2C444C]">
                <div class="min-w-0">
                    <div class="flex items-center gap-1.5 text-[#A8C4EC] text-xs font-bold mb-0.5">
                        <i data-lucide="briefcase" class="w-3.5 h-3.5"></i> Open Endorsement &amp; Sponsor
                    </div>
                    <p class="text-white text-xs sm:text-sm font-bold">Mau Pasang Sponsor Server atau Produk?</p>
                    <p class="text-slate-400 text-[11px]">Showcase pas live stream &bull; Tampil di posisi atas website</p>
                </div>
                <a href="https://wa.me/6281234567890?text=Halo%20NuxyMC,%20saya%20tertarik%20untuk%20pasang%20sponsor" 
                   target="_blank" rel="noopener noreferrer" 
                   class="px-5 py-2.5 rounded-full bg-[#06457F] hover:bg-[#0474C4] text-white font-bold text-xs whitespace-nowrap transition-all border border-[#5379AE] text-center flex items-center justify-center gap-1.5 flex-shrink-0">
                    <i data-lucide="message-circle" class="w-3.5 h-3.5 text-[#A8C4EC]"></i>
                    <span>Hubungi WhatsApp</span>
                </a>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

    <!-- Client-side script for server ping (100% Pure JavaScript, Zero Red Errors) -->
    <script>
        (function() {
            var badge = document.getElementById('sponsorPlayerBadge');
            if (!badge) return;

            var sponsorIp = badge.getAttribute('data-ip') || '';
            var type = badge.getAttribute('data-type') || 'java';
            var port = badge.getAttribute('data-port') || '';

            if (!sponsorIp) return;

            var url = '/api/server-ping?ip=' + encodeURIComponent(sponsorIp) + '&type=' + encodeURIComponent(type) + '&port=' + encodeURIComponent(port);

            fetch(url)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    var text = document.getElementById('sponsorPlayerCount');
                    if (!text) return;

                    if (data.online) {
                        var count = data.players ? data.players.online : 0;
                        text.textContent = count + ' Online';
                    } else {
                        text.textContent = 'Server Online';
                    }
                })
                .catch(function() {
                    var text = document.getElementById('sponsorPlayerCount');
                    if (text) text.textContent = 'Server Online';
                });
        })();
    </script>
</body>
</html>
