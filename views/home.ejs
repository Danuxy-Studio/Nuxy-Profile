<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen pb-4">
    <%- include('partials/preloader') %>
    <%- include('partials/nav') %>

    <%
    function mapIcon(icon, type) {
        const map = {
            'fas fa-gift': 'gift', 'fab fa-discord': 'message-circle', 'fab fa-whatsapp': 'phone',
            'fab fa-youtube': 'youtube', 'fab fa-tiktok': 'music-2', 'fab fa-instagram': 'instagram',
            'fab fa-twitter': 'twitter', 'fab fa-twitch': 'twitch', 'fab fa-facebook': 'facebook',
            'fab fa-github': 'github', 'fab fa-spotify': 'music', 'fab fa-telegram': 'send',
            'fab fa-linkedin': 'linkedin', 'fab fa-reddit': 'message-square', 'fab fa-pinterest': 'image',
            'fas fa-globe': 'globe', 'fas fa-envelope': 'mail', 'fas fa-heart': 'heart',
            'fas fa-coffee': 'coffee', 'fas fa-star': 'star', 'fas fa-crown': 'crown',
            'fas fa-users': 'users', 'fas fa-link': 'link', 'fas fa-hand-holding-heart': 'hand-heart',
            'fas fa-sack-dollar': 'circle-dollar-sign', 'fas fa-donate': 'gift'
        };
        if (map[icon]) return map[icon];
        if (icon && icon.startsWith('lucide:')) return icon.replace('lucide:', '');
        if (type === 'donate') return 'gift';
        if (type === 'community') return 'users';
        return 'link';
    }
    %>

    <main class="w-full px-4 py-8 md:py-12">
        <div class="max-w-xl mx-auto w-full">
            <!-- Skeleton -->
            <div id="skeleton">
                <div class="text-center mb-8">
                    <div class="skeleton w-28 h-28 rounded-full mx-auto mb-4"></div>
                    <div class="skeleton w-40 h-6 rounded-lg mx-auto mb-2"></div>
                    <div class="skeleton w-60 h-4 rounded-lg mx-auto"></div>
                </div>
                <div class="space-y-3">
                    <div class="skeleton h-[68px] rounded-2xl"></div>
                    <div class="skeleton h-[68px] rounded-2xl"></div>
                    <div class="skeleton h-[68px] rounded-2xl"></div>
                </div>
            </div>

            <!-- Content -->
            <div id="content" class="content-wrapper" style="display:none;">
                <!-- Profile Hero -->
                <div class="text-center mb-8 animate-fade-up">
                    <div class="w-28 h-28 rounded-full mx-auto p-1 bg-gradient-to-br from-purple-400 to-purple-700 shadow-lg shadow-purple-500/20 mb-4">
                        <div class="w-full h-full rounded-full overflow-hidden bg-slate-800 border-2 border-slate-950">
                            <img src="<%= profile.avatar_url || '/img/avatar.png' %>"
                                 alt="<%= profile.name %>"
                                 class="w-full h-full object-cover"
                                 onerror="this.src='/img/avatar.png'">
                        </div>
                    </div>
                    <h1 class="text-2xl font-bold gradient-text mb-1 break-words"><%= profile.name %></h1>
                    <% if (profile.bio) { %>
                        <p class="text-slate-400 text-sm max-w-xs mx-auto break-words"><%= profile.bio %></p>
                    <% } %>
                </div>

                <!-- Links -->
                <div class="space-y-3">
                    <% if (profile.socials && profile.socials.length > 0) { %>
                        <% profile.socials.forEach(function (link, index) {
                            let badgeClass = 'bg-purple-500/15 text-purple-400';
                            let badgeText = 'Social';
                            if (link.type === 'donate') { badgeClass = 'bg-amber-500/15 text-amber-400'; badgeText = 'Donate'; }
                            else if (link.type === 'community') { badgeClass = 'bg-sky-500/15 text-sky-400'; badgeText = 'Community'; }
                        %>
                            <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"
                               class="glass-card flex items-center gap-4 p-4 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-purple-500/10 transition-all stagger-item"
                               style="animation-delay: <%= 0.05 * index %>s">
                                <div class="w-11 h-11 rounded-xl bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="<%= mapIcon(link.icon, link.type) %>" class="w-5 h-5 text-purple-400"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-semibold text-white text-sm truncate"><%= link.name %></p>
                                    <span class="inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full mt-1 <%= badgeClass %>"><%= badgeText %></span>
                                </div>
                                <i data-lucide="arrow-up-right" class="w-4 h-4 text-slate-500 flex-shrink-0"></i>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <div class="glass-card p-8 text-center">
                            <i data-lucide="link-2" class="w-10 h-10 text-slate-600 mx-auto mb-2"></i>
                            <p class="text-slate-500">Belum ada link</p>
                        </div>
                    <% } %>
                </div>

                <!-- Quick Menu -->
                <div class="mt-6 grid grid-cols-2 gap-3">
                    <a href="/mods" class="glass-card p-4 text-center hover:-translate-y-0.5 transition-all">
                        <i data-lucide="boxes" class="w-6 h-6 text-purple-400 mx-auto mb-1.5"></i>
                        <p class="text-white text-sm font-semibold">Modpacks</p>
                        <p class="text-slate-500 text-[11px] mt-0.5">Download mod</p>
                    </a>
                    <a href="/servers" class="glass-card p-4 text-center hover:-translate-y-0.5 transition-all">
                        <i data-lucide="server" class="w-6 h-6 text-purple-400 mx-auto mb-1.5"></i>
                        <p class="text-white text-sm font-semibold">Servers</p>
                        <p class="text-slate-500 text-[11px] mt-0.5">Join sekarang</p>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        (function () {
            const skeleton = document.getElementById('skeleton');
            const content = document.getElementById('content');
            setTimeout(function () {
                if (skeleton) skeleton.style.display = 'none';
                if (content) {
                    content.style.display = 'block';
                    requestAnimationFrame(() => content.classList.add('loaded'));
                }
                refreshIcons();
            }, 250);
        })();
    </script>
</body>
</html>
