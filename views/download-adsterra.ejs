<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/nav') %>

    <main class="max-w-md mx-auto px-4 py-10">
        <div class="text-center mb-6 animate-fade-up">
            <span class="text-[11px] font-semibold text-purple-400/80 uppercase tracking-wider">Download Modpack</span>
            <h1 class="text-xl md:text-2xl font-bold text-white mt-1"><%= mod.name %></h1>
            <div class="flex items-center justify-center gap-2 mt-1.5 text-xs text-slate-500">
                <span class="bg-purple-500/15 text-purple-400 px-2 py-0.5 rounded-full font-semibold">MC <%= mod.mc_version %></span>
                <span><%= mod.release_date %></span>
            </div>
        </div>

        <!-- Optional sponsor slot: clearly labeled, no intrusive scripts by default -->
        <div class="text-center mb-2">
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-400/80 bg-amber-500/10 px-2.5 py-1 rounded-full">Sponsored</span>
        </div>
        <div class="glass-card mb-5 min-h-[90px] flex items-center justify-center text-slate-600 text-xs">
            Ruang iklan (opsional)
        </div>

        <div class="glass-card p-6 md:p-7 mb-5 text-center animate-fade-up" style="animation-delay:.05s">
            <div class="relative w-24 h-24 mx-auto mb-4">
                <svg class="w-24 h-24 -rotate-90" viewBox="0 0 96 96">
                    <circle cx="48" cy="48" r="42" fill="none" stroke="rgba(168, 85, 247,0.15)" stroke-width="5"/>
                    <circle id="progressCircle" cx="48" cy="48" r="42" fill="none" stroke="#a855f7" stroke-width="5"
                            stroke-linecap="round" style="transition: stroke-dashoffset 0.3s linear;"/>
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span id="countdownNumber" class="text-3xl font-extrabold text-purple-400">5</span>
                </div>
            </div>
            <p class="text-slate-400 text-sm mb-1" id="statusText">
                Link aktif dalam <strong id="timeLeft" class="text-purple-400">5</strong> detik
            </p>
            <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden my-4">
                <div id="progressFill" class="h-full bg-purple-500 rounded-full transition-all" style="width:0%"></div>
            </div>
            <a href="#" id="downloadBtn"
               class="w-full py-3.5 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 bg-slate-800 text-slate-500 pointer-events-none transition-all">
                <i data-lucide="lock" class="w-4 h-4"></i><span>Mohon tunggu...</span>
            </a>
        </div>

        <div class="text-center">
            <a href="/mods" class="text-slate-600 hover:text-slate-400 transition-colors text-xs">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5 inline -mt-0.5"></i> Kembali ke daftar modpack
            </a>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        (function () {
            refreshIcons();
            const TOTAL = 5;
            let timeLeft = TOTAL;
            const circle = document.getElementById('progressCircle');
            const circumference = 2 * Math.PI * 42;
            circle.style.strokeDasharray = circumference;
            circle.style.strokeDashoffset = circumference;

            function update() {
                const progress = (TOTAL - timeLeft) / TOTAL;
                circle.style.strokeDashoffset = circumference * (1 - progress);
                document.getElementById('progressFill').style.width = (progress * 100) + '%';
                document.getElementById('countdownNumber').textContent = timeLeft;
                document.getElementById('timeLeft').textContent = timeLeft;
            }
            update();

            const timer = setInterval(() => {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    circle.style.strokeDashoffset = 0;
                    document.getElementById('progressFill').style.width = '100%';
                    document.getElementById('countdownNumber').textContent = '✓';
                    document.getElementById('statusText').innerHTML = '<span class="text-purple-400">Link download siap!</span>';

                    const btn = document.getElementById('downloadBtn');
                    btn.href = '/go/<%= mod.id %>';
                    btn.classList.remove('bg-slate-800', 'text-slate-500', 'pointer-events-none');
                    btn.classList.add('btn-primary', 'text-white');
                    btn.innerHTML = '<i data-lucide="download" class="w-4 h-4"></i><span>Download Sekarang</span>';
                    refreshIcons();
                    return;
                }
                update();
            }, 1000);
        })();
    </script>
</body>
</html>
