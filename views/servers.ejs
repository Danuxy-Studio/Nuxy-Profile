<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen">
    <%- include('partials/preloader') %>
    <%- include('partials/nav') %>

    <main class="max-w-2xl mx-auto px-4 py-8">
        <div class="text-center mb-6 animate-fade-up">
            <h1 class="text-2xl md:text-3xl font-bold gradient-text mb-1 flex items-center justify-center gap-2">
                <i data-lucide="server" class="w-7 h-7 text-purple-400"></i> Servers &amp; Community
            </h1>
            <p class="text-slate-400 text-sm">Join server kami atau gabung komunitas!</p>
        </div>

        <!-- How to join -->
        <div class="glass-card p-5 mb-5 animate-fade-up" style="animation-delay:.05s">
            <p class="text-white font-semibold text-sm flex items-center gap-2 mb-3">
                <i data-lucide="circle-help" class="w-4 h-4 text-purple-400"></i> Cara Join Server
            </p>
            <ol class="text-slate-300 text-xs space-y-2.5">
                <li class="flex items-start gap-2.5">
                    <span class="w-5 h-5 rounded-full bg-purple-500/15 text-purple-400 text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5 font-bold">1</span>
                    <span>Tap IP server di bawah untuk menyalin otomatis</span>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="w-5 h-5 rounded-full bg-purple-500/15 text-purple-400 text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5 font-bold">2</span>
                    <span>Buka Minecraft → Multiplayer → Add Server</span>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="w-5 h-5 rounded-full bg-purple-500/15 text-purple-400 text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5 font-bold">3</span>
                    <span>Tempel (paste) IP yang sudah disalin</span>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="w-5 h-5 rounded-full bg-purple-500/15 text-purple-400 text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5 font-bold">4</span>
                    <span>Save &amp; Join! 🚀</span>
                </li>
            </ol>
        </div>

        <% if (servers && servers.length > 0) { %>
            <div class="space-y-4">
                <% servers.forEach(function (server, idx) { %>
                    <div class="glass-card p-5 stagger-item" style="animation-delay: <%= 0.08 * idx %>s">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center">
                                <i data-lucide="server" class="w-5 h-5 text-purple-400"></i>
                            </div>
                            <h2 class="text-white font-bold text-lg"><%= server.name %></h2>
                            <span class="ml-auto text-[10px] font-semibold px-2 py-1 rounded-full bg-purple-500/15 text-purple-400 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span> Online
                            </span>
                        </div>

                        <div class="space-y-3">
                            <% if (server.has_java) { %>
                                <div>
                                    <p class="text-slate-400 text-xs font-medium mb-1.5 flex items-center gap-1.5">
                                        <i data-lucide="coffee" class="w-3.5 h-3.5 text-amber-400"></i> Java Edition
                                    </p>
                                    <button onclick="copyText('<%= server.java_ip %>')"
                                            class="w-full bg-slate-900/60 border border-slate-800 rounded-xl px-4 py-3 flex items-center justify-between gap-2 hover:border-purple-500/40 transition-colors text-left">
                                        <code class="text-purple-400 font-mono text-sm break-all"><%= server.java_ip %></code>
                                        <i data-lucide="copy" class="w-4 h-4 text-slate-500 flex-shrink-0"></i>
                                    </button>
                                </div>
                            <% } %>

                            <% if (server.has_bedrock) { %>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <p class="text-slate-400 text-xs font-medium mb-1.5 flex items-center gap-1.5">
                                            <i data-lucide="smartphone" class="w-3.5 h-3.5 text-sky-400"></i> Bedrock IP
                                        </p>
                                        <button onclick="copyText('<%= server.bedrock_ip %>')"
                                                class="w-full bg-slate-900/60 border border-slate-800 rounded-xl px-3 py-3 flex items-center justify-between gap-2 hover:border-purple-500/40 transition-colors text-left">
                                            <code class="text-purple-400 font-mono text-xs break-all"><%= server.bedrock_ip %></code>
                                            <i data-lucide="copy" class="w-3.5 h-3.5 text-slate-500 flex-shrink-0"></i>
                                        </button>
                                    </div>
                                    <div>
                                        <p class="text-slate-400 text-xs font-medium mb-1.5">Port</p>
                                        <button onclick="copyText('<%= server.bedrock_port %>')"
                                                class="w-full bg-slate-900/60 border border-slate-800 rounded-xl px-3 py-3 flex items-center justify-between gap-2 hover:border-purple-500/40 transition-colors text-left">
                                            <code class="text-purple-400 font-mono text-xs"><%= server.bedrock_port %></code>
                                            <i data-lucide="copy" class="w-3.5 h-3.5 text-slate-500 flex-shrink-0"></i>
                                        </button>
                                    </div>
                                </div>
                            <% } %>

                            <% if (server.community && (server.community.whatsapp || server.community.discord)) { %>
                                <div class="pt-3 border-t border-slate-800/70">
                                    <p class="text-slate-500 text-xs mb-2 flex items-center gap-1.5">
                                        <i data-lucide="users" class="w-3.5 h-3.5"></i> Join Komunitas
                                    </p>
                                    <div class="flex gap-2 flex-wrap">
                                        <% if (server.community.whatsapp) { %>
                                            <a href="<%= server.community.whatsapp %>" target="_blank" rel="noopener noreferrer"
                                               class="flex-1 min-w-[130px] bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/20 rounded-xl px-4 py-2.5 flex items-center justify-center gap-2 text-white text-sm font-medium transition-colors">
                                                <i data-lucide="phone" class="w-4 h-4 text-purple-400"></i> WhatsApp
                                            </a>
                                        <% } %>
                                        <% if (server.community.discord) { %>
                                            <a href="<%= server.community.discord %>" target="_blank" rel="noopener noreferrer"
                                               class="flex-1 min-w-[130px] bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/20 rounded-xl px-4 py-2.5 flex items-center justify-center gap-2 text-white text-sm font-medium transition-colors">
                                                <i data-lucide="message-circle" class="w-4 h-4 text-indigo-400"></i> Discord
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="glass-card p-10 text-center">
                <i data-lucide="server-off" class="w-12 h-12 text-slate-600 mx-auto mb-3"></i>
                <p class="text-slate-400 font-medium">Belum ada server</p>
                <p class="text-slate-600 text-sm mt-1">Cek lagi nanti ya!</p>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>
    <script>refreshIcons();</script>
</body>
</html>
